# ============================================
# Git 추적 제외 파일 (.gitignore)
# ============================================
# 대용량 바이너리와 생성 파일은 Git에서 제외
# ============================================

# ---------- 🎧 대용량 오디오 파일 ----------
audiobook/mp3/
*.mp3

# ---------- 🤖 TTS 모델 파일 ----------
audiobook/models/
*.onnx
*.pt
*.pth
*.ckpt

# ---------- 🗑️ Python 캐시 ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/

# ---------- 📦 Node ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- 🔧 빌드 아티팩트 ----------
dist/
build/
*.egg-info/

# ---------- 💻 OS/에디터 ----------
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
*.swp
*.swo
*~

# ---------- 🔐 환경 변수 ----------
.env
.env.local
.env.*.local

# ---------- 📊 생성 진행 상태 ----------
.generation_progress.json

# ---------- 📂 아카이브 ----------
archive/

# ----------  대용량 HTML (GitHub 100MB 한도 초과) ----------
content/**/*.html
