{
  "name": "cosmetic-pass-master",
  "version": "1.0.0",
  "description": "맞춤형화장품 조제관리사 자격시험 스마트 학습 플랫폼",
  "main": "serve.js",
  "scripts": {
    "build:data": "node tools/build/index.js",
    "build:data:law": "node tools/build/index.js --only law",
    "build:data:manufacturing": "node tools/build/index.js --only manufacturing",
    "build:data:safety": "node tools/build/index.js --only safety",
    "build:data:understanding": "node tools/build/index.js --only understanding",
    "postbuild:data": "npm run check:parser",
    "check:parser": "node tools/check_parser_parity.js",
    "stamp:sw": "node tools/build/stamp-sw-version.js",
    "build:study-md": "node tools/build_study_md_bundle.js",
    "test": "node --test tests/unit/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:dom": "vitest run",
    "test:all": "node --test tests/unit/*.test.js && node tools/check_parser_parity.js && vitest run",
    "test:watch": "node --test --watch tests/unit/*.test.js",
    "serve": "node serve.js"
  },
  "keywords": [
    "cosmetics",
    "education",
    "pwa",
    "vanilla-js"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^30.0.1",
    "vitest": "^4.1.11"
  }
}
