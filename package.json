{
  "name": "cosmetic-pass-master",
  "version": "1.0.0",
  "description": "맞춤형화장품 조제관리사 자격시험 스마트 학습 플랫폼",
  "main": "serve.js",
  "scripts": {
    "build:data": "npm run build:exams-list && npm run build:pdf-registry && npm run build:keyword-index && node tools/build/build_all_data.js && npm run build:study-md && npm run build:exam-bundles && npm run build:audio-manifest && npm run sync:citations && npm run build:question-chapters && npm run build:id-migration",
    "build:question-chapters": "node tools/build/build_question_chapters.js",
    "build:id-migration": "node tools/build/build_id_migration.js",
    "build:exams-list": "node tools/build/build_exams_list.js",
    "build:data:law": "node tools/build/index.js --only law",
    "build:data:manufacturing": "node tools/build/index.js --only manufacturing",
    "build:data:safety": "node tools/build/index.js --only safety",
    "build:data:understanding": "node tools/build/index.js --only understanding",
    "build:pdf-registry": "node tools/build/build_pdf_registry.js",
    "build:keyword-index": "node tools/build/build_keyword_index.js",
    "build:exam-bundles": "node tools/build/build_exam_bundles.js",
    "build:audio-manifest": "node tools/build/build_audio_manifest.js",
    "sync:citations": "node tools/sync_citation_lines.js",
    "postbuild:data": "npm run check:parser",
    "check:parser": "node tools/check_parser_parity.js",
    "check:imports": "node tools/check_imports.js",
    "check:combo": "node tools/check_combo_pilot.js",
    "check:refsubjects": "node tools/check_ref_subjects.js",
    "check:refmerge": "node tools/check_refmerge.js",
    "check:reflayout": "node tools/check_reflayout.js",
    "check:reffresh": "node tools/check_ref_freshness.js",
    "check:reflines": "node tools/check_ref_lines.js",
    "check:drillfresh": "node tools/check_drill_freshness.js",
    "check:docs": "node tools/check_docs_paths.js",
    "convert:refs": "python ref-pipeline/convert.py",
    "verify:refs": "python ref-pipeline/convert.py --verify",
    "build:drills": "node tools/build/build_ox_drills.js && node tools/build/build_combo_drills.js",
    "stamp:sw": "node tools/build/stamp_sw_version.js",
    "notes:draft": "node tools/build/stamp_release_notes.js --draft",
    "verify:assets": "node tools/verify_shell_assets.js",
    "build:study-md": "node tools/build/build_study_md_bundle.js",
    "test": "node --test tests/unit/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:dom": "vitest run",
    "coverage": "vitest run --coverage",
    "coverage:unit": "c8 --reporter=json --report-dir=coverage-unit --include \"src/**/*.js\" node --test tests/unit/*.test.js",
    "coverage:all": "npm run coverage && npm run coverage:unit && node tools/coverage_merge.js",
    "test:all": "node --test tests/unit/*.test.js && node tools/check_parser_parity.js && node tools/check_imports.js && vitest run",
    "test:watch": "node --test --watch tests/unit/*.test.js",
    "serve": "node serve.js",
    "audit:cards": "node tools/audit_card_quality.js",
    "check:manifest": "node tools/check_manifest.js",
    "check:content": "node tools/check_content.js",
    "deploy": "node tools/deploy.js",
    "audit:combo": "node tools/audit_combo.js"
  },
  "keywords": [
    "cosmetics",
    "education",
    "pwa",
    "vanilla-js"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "c8": "^12.0.0",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.2.0",
    "jsdom": "^30.0.1",
    "vitest": "^4.1.11"
  }
}
