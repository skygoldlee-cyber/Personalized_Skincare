#!/bin/sh
# pre-push — push 전 빠른 품질 게이트 (opt-in: npm run hooks:install)
#
# 실행 내용 (약 수 초):
#   1. check:types    — tsc 타입 진단 (IDE 오류 상태의 push 차단)
#   2. check:trace    — TRACE_MATRIX 신선도 (SPEC/@spec 변경 후 재생성 누락 차단)
#   3. check:specrefs — 스테일 SPEC 참조 + 테스트 갭 기준선
#   4. check:docs     — 문서 경로 + DOC ID
#   5. check:html     — index.html이 파셜(html/views/) 조립 결과와 일치하는지
#   6. lint           — ESLint 에러 (경고는 통과)
#   7. impact tests   — origin/main 대비 변경 파일의 @spec 역산 → 해당 unit/DOM 테스트만 실행
#   8. check:docsync  — 소스 변경에 문서 갱신 동반 여부
#   9. check:testfirst — 로직(src/·ref-pipeline/) 변경에 테스트 동반 여부 (Docs-First)
#
# 건너뛰기: SKIP_PREPUSH=1 git push

if [ "$SKIP_PREPUSH" = "1" ]; then
    exit 0
fi

# PowerShell 환경 — npm.cmd 우선, 없으면 npm (Git Bash/macOS)
if command -v npm.cmd >/dev/null 2>&1; then NPM="npm.cmd"; else NPM="npm"; fi

echo "▶ pre-push 품질 게이트"

for check in check:types check:trace check:specrefs check:docs check:html lint; do
    echo "  - npm run $check"
    $NPM run "$check" --silent || {
        echo "✗ pre-push 차단: $check 실패"
        echo "  우회: SKIP_PREPUSH=1 git push"
        exit 1
    }
done

# 영향 테스트 게이트 — push 대상 diff의 @spec을 역산해 관련 unit/DOM 테스트만 실행.
# 변경 파일에 추적 태그가 없으면 권장 테스트 0개로 스킵(통과)된다.
echo "  - node tools/check/impact_tests.js --ref origin/main --run"
node tools/check/impact_tests.js --ref origin/main --run || {
    echo "✗ pre-push 차단: 영향 테스트 실패"
    echo "  우회: SKIP_PREPUSH=1 git push"
    exit 1
}

# 문서 동기화 게이트 — push되는 커밋 범위(origin/main..HEAD)에 소스 변경이
# 있으면 문서(docs/·AGENTS.md·README.md) 갱신이 함께 있어야 한다.
echo "  - node tools/check/check_doc_sync.js --ref origin/main"
node tools/check/check_doc_sync.js --ref origin/main || {
    echo "✗ pre-push 차단: 소스 변경에 문서 갱신이 동반되지 않았습니다"
    echo "  우회: SKIP_PREPUSH=1 git push"
    exit 1
}

# 테스트 선행 게이트 — push 범위에 로직(src/·ref-pipeline/) 변경이 있으면
# 테스트(tests/·ref-pipeline/tests/) 변경이 함께 있어야 한다.
echo "  - node tools/check/check_test_first.js --ref origin/main"
node tools/check/check_test_first.js --ref origin/main || {
    echo "✗ pre-push 차단: 로직 변경에 테스트 변경이 동반되지 않았습니다"
    echo "  우회: SKIP_PREPUSH=1 git push"
    exit 1
}

echo "✓ pre-push 통과"
