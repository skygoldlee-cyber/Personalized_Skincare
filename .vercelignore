# ============================================
# Vercel 배포 제외 파일 (.vercelignore)
# ============================================
# 총 프로젝트 크기: ~1.03GB
# Vercel 업로드 대상: ~5MB (핵심 앱만)
# ============================================

# ---------- 🎧 대용량 오디오 (302MB) ----------
audiobook/mp3/
*.mp3

# ---------- 📚 정적 HTML 콘텐츠 (전면 폐기됨) ----------
# 교재 본문은 이제 content/*.md 를 런타임에 fetch → src/textbook-parser.js 로
# 파싱하여 렌더링한다(사전 렌더 HTML 불필요). content/*.html 은 삭제되었다.
# 앱에서 링크로 여는 문서 HTML(docs/*.html)만 배포에 포함하고,
# 루트 index.html(진입점)은 반드시 유지한다.
# ※ 교재/카드/퀴즈: content/*.md(원본, 배포됨) + data/study_md.js(file://·fetch실패 폴백)
# ※ 문제집: content/exams/*.md(원본) + data/exams_md/*.js(file:// 폴백)
*.html
!index.html
!docs/*.html

# ---------- 🗑️ 구(모놀리식) 죽은 데이터 파일 ----------
# index.html은 모듈러 구조(registry + data/subjects·exams/*.hash.js)만 로드한다.
# 아래 구 단일 번들은 어디에서도 로드되지 않으므로(합계 ~1.48MB) 배포에서 제외한다.
# (리포에서도 제거 권장 — 재생성은 tools/build/index.js가 담당)
# data/study_data.js, data/exam_data.js는 이미 삭제됨 — .vercelignore에서도 제거 가능하나
# 혹시 모를 로컬 잔재를 위해 규칙은 유지한다.
data/study_data.js
data/exam_data.js

# ---------- 🗑️ 미사용 과목 번들 (런타임 MD 파싱으로 대체) ----------
# 교재/카드/퀴즈는 content/*.md 런타임 파싱으로 로드하므로 data/subjects/*.js 는
# 더 이상 로드되지 않는다. `npm run build:data` 가 재생성하더라도 배포에서 제외한다.
data/subjects/

# ---------- 🗑️ file:// 전용 폴백 번들 ----------
# data/docs_md/는 file:// 프로토콜(로컬 직접 열기)뿐 아니라
# 모바일 PWA에서 fetch 실패 시 폴백으로도 사용되므로 배포에 포함한다.
data/exams_md/
data/study_md/

# ---------- ⏳ 일회성 ID 마이그레이션 맵 (유예 후 제거 가능) ----------
# data/id_migration.js(약 63KB)는 레거시 ID → 안정 ID 일회성 이관용이며 현재는 필요하다.
# 대다수 사용자가 마이그레이션(fc_migrated_v2)을 마친 뒤에는 배포에서 제외할 수 있다.
# 제거 시 index.html의 <script src="data/id_migration.js"> 태그도 함께 제거할 것.
# (state.js가 typeof ID_MIGRATION_MAP === 'undefined'를 가드하므로 안전)
# 아래 줄의 주석을 해제하면 배포에서 제외된다:
# data/id_migration.js

# ---------- 🔁 Vercel 빌드 캐시 ----------
.vercel/
.vercel

# ---------- 📂 아카이브된 원본 폴터 ----------
# content/와 동일한 MD 파일들의 중복 (archive/로 이동됨)
archive/

# ---------- 🔧 개발 도구 및 파이프라인 ----------
content/audiobook/
tools/
*.py
*.ps1
requirements.txt
.env.example
.generation_progress.json

# ---------- � Node (개발 의존성 — 배포 불필요) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ---------- �🗑️ 캐시 및 빌드 아티팩트 ----------
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# ---------- 📝 문서 (선택적) ----------
# docs/는 필요시 주석 해제
# docs/

# ---------- 💻 OS/에디터 ----------
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
*.swp
*.swo

# ---------- 📦 Git ----------
.git/
.gitignore
.gitattributes
