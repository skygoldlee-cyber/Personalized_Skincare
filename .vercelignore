# ============================================
# Vercel 배포 제외 파일 (.vercelignore)
# ============================================
# 총 프로젝트 크기: ~1.03GB
# Vercel 업로드 대상: ~5MB (핵심 앱만)
# ============================================

# ---------- 🎧 대용량 오디오 (302MB) ----------
audiobook/mp3/
*.mp3

# ---------- 📚 비대화된 HTML 콘텐츠 ----------
# 앱은 data/registry.js + data/subjects·exams/*.js(모듈러 번들)를 로드하므로
# content/ 등에서 렌더링된 HTML은 제외하되,
# 앱에서 링크로 여는 문서 HTML(docs/*.html) 및 모의고사 HTML(exams/*.html)은 반드시 배포에 포함해야 한다.
# (루트 index.html은 진입점이므로 반드시 유지)
*.html
!index.html
!docs/*.html
!exams/*.html

# ---------- 🗑️ 구(모놀리식) 죽은 데이터 파일 ----------
# index.html은 모듈러 구조(registry + data/subjects·exams/*.hash.js)만 로드한다.
# 아래 구 단일 번들은 어디에서도 로드되지 않으므로(합계 ~1.48MB) 배포에서 제외한다.
# (리포에서도 제거 권장 — 재생성은 tools/build/index.js가 담당)
data/study_data.js
data/exam_data.js

# ---------- ⏳ 일회성 ID 마이그레이션 맵 (유예 후 제거 가능) ----------
# data/id_migration.js(약 63KB)는 레거시 ID → 안정 ID 일회성 이관용이며 현재는 필요하다.
# 대다수 사용자가 마이그레이션(fc_migrated_v2)을 마친 뒤에는 배포에서 제외할 수 있다.
# 제거 시 index.html의 <script src="data/id_migration.js"> 태그도 함께 제거할 것.
# (state.js가 typeof ID_MIGRATION_MAP === 'undefined'를 가드하므로 안전)
# 아래 줄의 주석을 해제하면 배포에서 제외된다:
# data/id_migration.js

# ---------- 🔁 Vercel 빌드 캐시 ----------
.vercel/
.vercel

# ---------- 📂 아카이브된 원본 폴터 ----------
# content/와 동일한 MD 파일들의 중복 (archive/로 이동됨)
archive/

# ---------- 🔧 개발 도구 및 파이프라인 ----------
audiobook/
tools/
*.py
*.ps1
requirements.txt
.env.example
.generation_progress.json

# ---------- 🗑️ 캐시 및 빌드 아티팩트 ----------
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/

# ---------- 📝 문서 (선택적) ----------
# docs/는 필요시 주석 해제
# docs/

# ---------- 💻 OS/에디터 ----------
.DS_Store
Thumbs.db
*.log
.vscode/
.idea/
*.swp
*.swo

# ---------- 📦 Git ----------
.git/
.gitignore
.gitattributes
