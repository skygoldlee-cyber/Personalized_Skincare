# ElevenLabs API 키 (https://elevenlabs.io → Profile → API Key)
# PowerShell에서 설정:
#   $env:ELEVENLABS_API_KEY="여기에_키_붙여넣기"
# 또는 이 파일을 .env로 복사 후 값을 채우고, 실행 전 아래 명령으로 로드:
#   Get-Content .env | ForEach-Object { $n,$v = $_ -split '=',2; [Environment]::SetEnvironmentVariable($n, $v) }
ELEVENLABS_API_KEY=

# (선택) 사용할 음성 ID — 지정하지 않으면 --voice 옵션(기본: Aria) 사용
# 음성 ID 확인: ElevenLabs 웹 → Voices → 음성 클릭 → ID 복사 (20자 영숫자)
ELEVENLABS_VOICE_ID=
