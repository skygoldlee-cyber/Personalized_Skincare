{
  // 개선안 1-3: 타입 안정성 (점진적 도입)
  // JSDoc(@typedef/@type) 기반의 편집기 자동완성·진단을 활성화합니다.
  // 별도 빌드 단계 없이 VS Code 등 TS 언어 서버가 이 설정을 읽어 검사합니다.
  //
  // [점진적 확장 방법]
  //   현재 include 는 "이미 타입 주석이 정리되어 진단이 깨끗한" 파일만 담습니다.
  //   나머지 로직 파일(app.js, data-loader.js, textbook-parser.js, views/* 등)은
  //   JSDoc 주석을 보강해 진단을 정리한 뒤 하나씩 include 에 추가하세요.
  //   (한 번에 전체를 켜면 기존 미타이핑 코드의 진단이 쏟아져 신호가 묻힙니다.)
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": [
    "src/globals.d.ts",
    "src/types.js",
    "src/state.js",
    "src/charts.js",
    "src/sanitize.js",
    "src/utils.js",
    "src/data-loader.js",
    "src/pdf-registry.js",
    "src/reader-format.js",
    "data/registry.js",
    "data/audio_manifest.js"
  ],
  "exclude": [
    "node_modules",
    "vendor",
    "data/exams",
    "data/ingredients_data.*.js",
    "data/study_md.js",
    "data/id_migration.js"
  ]
}
